{
  "name": "daily-news-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api,search \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:search\"",
    "dev:web": "npm --prefix apps/web start",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:search": "cd apps/search_engine && mvnw.cmd spring-boot:run",
    "dev:ui": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "install-fe": "npm --prefix apps/web install",
    "install-be:api": "npm --prefix apps/api install"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
